{
	"name": "tieba-toolbox",
	"private": true,
	"packageManager": "bun@1.2.11",
	"workspaces": [
		"apps/*",
		"packages/*",
		"!packages/analysis"
	],
	"scripts": {
		"init": "bun scripts/init-env.mjs",
		"dev": "turbo dev",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"proto:gen": "turbo proto:gen",
		"tsconfig:sync": "bun scripts/sync-tsconfig.mjs",
		"db:push": "bun run --cwd apps/api db:push",
		"api:export": "bun run --cwd apps/api export",
		"api:export:config": "bun run --cwd apps/api export:config",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"lint": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@types/bun": "latest",
		"turbo": "^2",
		"typescript": "^5"
	}
}
