{
	"name": "tieba-toolbox",
	"private": true,
	"packageManager": "bun@1.2.11",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"proto:gen": "turbo proto:gen",
		"tsconfig:sync": "bun scripts/sync-tsconfig.mjs",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"lint": "biome check ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@types/bun": "latest",
		"turbo": "^2",
		"typescript": "^5"
	}
}
